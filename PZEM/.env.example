# PZEM pump-energy logger config.
# Copy this to ".env" (same folder as your smartfarm root, e.g. ~/smartfarm/.env)
# and fill in the real values. config.py loads it automatically.
# Real environment variables (or systemd Environment=) override these.

# ---- MQTT broker (pn64 = 192.168.1.156) ----
MQTT_BROKER=192.168.1.156
MQTT_PORT=1883
MQTT_USER=pop
MQTT_PASS=pop1
MQTT_TOPIC=smartfarm/pump/#
MQTT_PRESSURE_TOPIC=smartfarm/pressure/#

# ---- MariaDB ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartfarm
DB_USER=smartfarm_writer
DB_PASS=CHANGE_ME

# ---- logger tuning (optional) ----
BATCH_SIZE=50
FLUSH_SECS=10
PUMP_REFRESH_SECS=300

# ---- pressure sensor (optional; tune without re-flashing the ESP32) ----
PRESSURE_FS_BAR=10.0        # full scale (145 psi)
PRESSURE_V_MIN=0.5          # sensor V at 0 bar
PRESSURE_V_MAX=4.5          # sensor V at full scale
PRESSURE_NOFLOW_BAR=0.2     # <= this => status NO_FLOW
PRESSURE_MIN_BAR=1.0        # <  this => status LOW
PRESSURE_MAX_BAR=8.0        # >  this => status HIGH
PRESSURE_RUN_BAR=0.5        # >= this => is_running=1
