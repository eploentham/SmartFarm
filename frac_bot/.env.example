# Copy this to ".env" and fill in your values. Never commit the real .env.

# From BotFather (/newbot). Change ONLY this line if the bot is ever deleted.
TELEGRAM_TOKEN=123456:ABC-your-new-token-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# MariaDB on the RPi 4 (smartfarm)
DB_HOST=192.168.0.253
DB_USER=logger
DB_PASS=your-db-password
DB_NAME=smartfarm

# Where pictures are kept (your dataset base on the home computer)
IMAGE_DIR=./frac_labels
