[Unit]
Description=Durian canopy yellowing capture (daily)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=ekapop
WorkingDirectory=/home/ekapop/smartfarm
ExecStart=/home/ekapop/smartfarm/venv/bin/python /home/ekapop/smartfarm/detect_yellowing_durian.py