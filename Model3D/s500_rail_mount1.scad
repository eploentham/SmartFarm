$fn = 60; // ความละเอียดรูกลมสูงสุด

module s500_rail_mount_perfect() {
    difference() {
        // --- 1. บล็อกยึดรางคู่ (Solid Body - ปรับขนาดเพื่อรองรับระยะท่อ 60mm จากหน้างานวัดจริง) ---
        union() {
            // แผ่นเพลทหลัก หนา 5mm ปรับความลึกแกน Y ให้กระชับพอดีรอบท่อ (กว้าง 84mm / ลึก 72mm)
            translate([-42, -36, 0]) cube([84, 72, 5]);
            
            // บล็อกหนาสำหรับโอบอุ้มรูเจาะท่อคาร์บอน 10mm (ขยับพิกัดตามตำแหน่งรางคู่ 60mm)
            translate([-42, -36, 5]) cube([84, 12, 12]); // บล็อกหนาฝั่งลบ
            translate([-42,  24, 5]) cube([84, 12, 12]); // บล็อกหนาฝั่งบวก
        }
        
        // --- 2. [ปรับให้พอดีแล้ว] รูเจาะสำหรับสไลด์ท่อ Carbon Fiber ø10.2mm (เผื่อหลวม 0.2mm ให้สไลด์ประกอบง่าย) ---
        // ปรับพิกัดมาอยู่ที่ Y = -30 และ Y = 30 ส่งผลให้ระยะห่างกึ่งกลางท่อเท่ากับ 60mm เป๊ะตามสเกลเวอร์เนียร์หน้างาน
        translate([-43, -30, 11]) rotate([0, 90, 0]) cylinder(d=10.2, h=86);
        translate([-43,  30, 11]) rotate([0, 90, 0]) cylinder(d=10.2, h=86);
        
        // รูเจาะน็อตแนวตั้งสำหรับบีบล็อกท่อคาร์บอน (ใช้สกรู M3 หนีบพลาสติก ขยับตรงตำแหน่งเซ็นเตอร์ท่อพอดี)
        translate([-25, -30, 0]) cylinder(d=3, h=25);
        translate([ 25, -30, 0]) cylinder(d=3, h=25);
        translate([-25,  30, 0]) cylinder(d=3, h=25);
        translate([ 25,  30, 0]) cylinder(d=3, h=25);

        // --- 3. [คงพิกัดแม่นยำ] รูเจาะทะลุเรียบตรง ø3.2mm สำหรับให้เกลียวลูกยางกันสั่น M3 แทงผ่าน ---
        // พิกัดล็อกตายตัวแมตช์กับชิ้นล่างของเซ็นเซอร์ทุกโมเดล: X = ±33, Y = ±11
        translate([-33, -11, -2]) cylinder(d=3.2, h=10);
        translate([ 33, -11, -2]) cylinder(d=3.2, h=10);
        translate([-33,  11, -2]) cylinder(d=3.2, h=10);
        translate([ 33,  11, -2]) cylinder(d=3.2, h=10);
    }
}

// สั่งทำงานแสดงผลโมเดลชิ้นบนที่ผ่านการปรับระยะให้ตรงกับสเกลหน้างานจริง
s500_rail_mount_perfect();