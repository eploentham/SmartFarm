$fn = 60; // ความละเอียดรูกลมมาตรฐาน

module sensor_housing_extended_with_mtf01p() {
    difference() {
        // --- 1. ชิ้นงานตันหลัก (Solid Body + ครีบ Rib + แผ่นรับ MTF-01P ขยายความยาว) ---
        union() {
            // [แผ่นนอน] หนา 4mm ขนาด 80x32mm วางศูนย์กลางที่ Y = 0 (ผิวแบนราบรับลูกยางเกลียว)
            translate([-40, -16, 47]) cube([80, 32, 4]);
            
            // [แผ่นตั้งยึดเซ็นเซอร์] ยาวลงมาอีก 1cm จากเดิม Z=-15 เปลี่ยนเป็น Z=-25 ถึง 47 (ความยาวดิ่งรวม 72mm)
            translate([-40, -3, -25]) cube([80, 6, 72]);
            
            // ====================================================
            // แผ่นนอนด้านล่างสุดสำหรับยึด MTF-01P (หนา 4mm ยื่นไปด้านหน้า)
            // วางระดับต่ำสุดอยู่ที่ Z = -25 ตามความยาวแผ่นตั้งที่ขยายเพิ่มขึ้น
            // ====================================================
            translate([-18, 3, -25]) cube([36, 24, 4]);
            
            // --- RIB ชุดฝั่งซ้าย (อยู่ที่ X = -26 หนา 4mm ผิวปิดสนิทเนียนเรียบต่อเนื่อง) ---
            translate([-26, -16, 25]) r_smooth_rib_front();
            translate([-26, 3, 25]) r_smooth_rib_rear();
            
            // --- RIB ชุดฝั่งขวา (อยู่ที่ X = 22 หนา 4mm ผิวปิดสนิทเนียนเรียบต่อเนื่อง) ---
            translate([22, -16, 25]) r_smooth_rib_front();
            translate([22, 3, 25]) r_smooth_rib_rear();
        }
        
        // --- 2. รูเจาะเรียบตรง ø3.2mm สำหรับรับเกลียวสกรู M3 ของลูกยาง Damper (4 จุด พิกัด X = ±33, Y = ±11) ---
        translate([-33, -11, 45]) cylinder(d=3.2, h=8);
        translate([33, -11, 45]) cylinder(d=3.2, h=8);
        translate([-33, 11, 45]) cylinder(d=3.2, h=8);
        translate([33, 11, 45]) cylinder(d=3.2, h=8);

        // ====================================================
        // [คงพิกัดแม่นยำ] รูเจาะทะลุเรียบตรงๆ สำหรับ TFmini Plus (X = ±14)
        // ====================================================
        translate([-14, 10, 32]) rotate([90,0,0]) cylinder(d=2.2, h=20);
        translate([14, 10, 20.5]) rotate([90,0,0]) cylinder(d=2.2, h=20);

        // ====================================================
        // [คงพิกัดแม่นยำ] รูเจาะทะลุเรียบตรงๆ สำหรับ Intel RealSense D435i (X = ±12.5)
        // ====================================================
        translate([-12.5, 10, -5]) rotate([90,0,0]) cylinder(d=3.2, h=20);
        translate([12.5, 10, -5]) rotate([90,0,0]) cylinder(d=3.2, h=20);
        
        // ====================================================
        // [คงพิกัดแม่นยำ] การเจาะเคลียร์พื้นที่และรูยึดสำหรับโมดูล MTF-01P
        // เจาะทะลุแผ่นรับที่ระนาบด้านล่างสุด (Z = -26)
        // ====================================================
        // รูยึดสกรูบอร์ด MTF-01P จำนวน 4 จุด (พิกัดระยะห่างกว้าง 24.3mm / ลึก 12mm)
        translate([-12.15,  9, -26]) cylinder(d=2.7, h=6);
        translate([ 12.15,  9, -26]) cylinder(d=2.7, h=6);
        translate([-12.15, 21, -26]) cylinder(d=2.7, h=6);
        translate([ 12.15, 21, -26]) cylinder(d=2.7, h=6);
        
        // ช่องหน้าต่างสี่เหลี่ยมตรงกลาง เคลียร์เลนส์กล้องและเลเซอร์ส่องพื้น (Size 18x10mm)
        translate([-9, 10, -26]) cube([18, 10, 6]);
    }
}

// Sub-module: สร้างโครงสร้างรูปทรง Rib ฝั่งหน้า (สโลปกลับหัว เนื้อเต็มเชื่อมต่อเนียน)
module r_smooth_rib_front() {
    polyhedron(
        points = [
            [0,  0, 22], [4,  0, 22], [4, 13,  0], 
            [0, 13,  0], [0, 13, 22], [4, 13, 22]
        ],
        faces = [[0, 1, 5, 4], [2, 3, 0, 1], [3, 2, 5, 4], [0, 4, 3], [1, 2, 5]]
    );
}

// Sub-module: สร้างโครงสร้างรูปทรง Rib ฝั่งหลัง (สโลปกลับหัว เนื้อเต็มเชื่อมต่อเนียน)
module r_smooth_rib_rear() {
    polyhedron(
        points = [
            [0,  0,  0], [4,  0,  0], [4,  0, 22], 
            [0,  0, 22], [0, 13, 22], [4, 13, 22]
        ],
        faces = [[0, 1, 2, 3], [3, 2, 5, 4], [1, 0, 4, 5], [0, 3, 4], [1, 5, 2]]
    );
}

// สั่งทำงานฟังก์ชันโครงสร้างเวอร์ชันไร้ Error พร้อมใช้งานจริง
sensor_housing_extended_with_mtf01p();