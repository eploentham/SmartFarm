$fn = 60; // ความละเอียดรูกลมสูงสุด

module sensor_housing_wide_ribs() {
    difference() {
        // --- 1. ชิ้นงานตันหลัก (Solid Body + ครีบ Rib 4 ตัว ถ่างออกกว้างพิเศษ) ---
        union() {
            // [แผ่นนอน] หนา 4mm ขนาด 80x32mm วางศูนย์กลางที่ Y = 0
            translate([-40, -16, 47]) cube([80, 32, 4]);
            
            // [แผ่นตั้งยึดเซ็นเซอร์] หนา 6mm ดิ่งลงมาจากกึ่งกลางแผ่นนอน (Y = -3 ถึง 3)
            translate([-40, -3, -15]) cube([80, 6, 62]);
            
            // --- RIB ชุดฝั่งซ้าย (อยู่ที่ X = -26 หนา 4mm วิ่งไปถึง -22) ---
            translate([-26, -16, 25]) r_rib_front();
            translate([-26, 3, 25]) r_rib_rear();
            
            // --- RIB ชุดฝั่งขวา (อยู่ที่ X = 22 หนา 4mm วิ่งไปถึง 26) ---
            translate([22, -16, 25]) r_rib_front();
            translate([22, 3, 25]) r_rib_rear();
        }
        
        // --- 2. รูเจาะระบบลดแรงสั่นสะเทือน (Rubber Damper Holes) 4 จุด ---
        // พิกัดล็อกตายตัวแมตช์กับชิ้นบน: X = ±33, Y = ±11
        translate([-33, -11, 46]) cylinder(d=4.9, h=6);
        translate([33, -11, 46]) cylinder(d=4.9, h=6);
        translate([-33, 11, 46]) cylinder(d=4.9, h=6);
        translate([33, 11, 46]) cylinder(d=4.9, h=6);

        // ====================================================
        // รูเจาะทะลุเรียบๆ สำหรับ TFmini Plus (X = ±14)
        // ====================================================
        translate([-14, 10, 32]) rotate([90,0,0]) cylinder(d=2.2, h=20);
        translate([14, 10, 20.5]) rotate([90,0,0]) cylinder(d=2.2, h=20);

        // ====================================================
        // รูเจาะทะลุเรียบๆ สำหรับ Intel RealSense D435i (X = ±12.5)
        // ====================================================
        translate([-12.5, 10, -5]) rotate([90,0,0]) cylinder(d=3.2, h=20);
        translate([12.5, 10, -5]) rotate([90,0,0]) cylinder(d=3.2, h=20);
    }
}

// Sub-modules สำหรับสร้างโครงสร้างรูปทรง Rib ชิ้นล่าง
module r_rib_front() {
    polyhedron(
        points = [
            [0,  0, 22], [4,  0, 22], [4, 13,  0], 
            [0, 13,  0], [0, 13, 22], [4, 13, 22]
        ],
        faces = [[0, 1, 5, 4], [2, 3, 0, 1], [3, 2, 5, 4], [0, 4, 3], [1, 2, 5]]
    );
}

module r_rib_rear() {
    polyhedron(
        points = [
            [0,  0,  0], [4,  0,  0], [4,  0, 22], 
            [0,  0, 22], [0, 13, 22], [4, 13, 22]
        ],
        faces = [[0, 1, 2, 3], [3, 2, 5, 4], [1, 0, 4, 5], [0, 3, 4], [1, 5, 2]]
    );
}

// รันโมเดลชิ้นล่าง
sensor_housing_wide_ribs();