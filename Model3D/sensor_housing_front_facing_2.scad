$fn = 60; // ความละเอียดรูกลมมาตรฐาน

module sensor_housing_front_facing_reinforced() {
    difference() {
        // --- 1. ชิ้นงานตันหลัก (Solid Body + ระบบรับแรงหนาพิเศษ) ---
        union() {
            // [แผ่นนอนบน] หนา 4mm ขนาด 80(X) x 44(Y) รองรับหน้าสัมผัสฐานลูกยางเกลียว M3
            translate([-40, -22, 47]) cube([80, 44, 4]);

            // [แผ่นตั้งเซ็นเซอร์หลัก] *อัปเดตขยายความหนาเป็น 8mm* (X = -4 ถึง 4) เพื่อความตึงตัวสูง 
            // หน้ากว้าง 60mm (Y = -30 ถึง 30) ยาวดิ่งลงมารวม 72mm (Z = -25 ถึง 47)
            translate([-4, -30, -25]) cube([8, 60, 72]);

            // [ระบบรับแรงเพิ่มใหม่: บ่ามุมฉากค้ำยันด้านหน้า] (Front Buttress Support)
            // เนื้อพลาสติกหนา 6mm ถ่วงไปฝั่งกล้อง (+X) ยาวกว้างเต็มหน้าแผ่นตั้ง 60mm ใต้แผ่นนอนบน 
            // ทำหน้าที่เป็นโคนเสารับแรงบิดและแรงปะทะลม ไม่ให้แผ่นตั้งหักงอ
            translate([4, -30, 41]) cube([6, 60, 6]);
            translate([-10, -30, 41]) cube([6, 60, 6]);
            

            // [แผ่นรับ MTF-01P ด้านล่างสุด] หนา 4mm ยื่นไปด้านหลัง (-X) 24mm กว้าง 36mm ล็อกกับระนาบ Z=-25
            translate([-12, -18, -29]) cube([24, 36, 4]);

            // [ครีบ Rib หนาแน่นฝั่งหลัง -X] อยู่ 2 ปลายที่ Y = -22 และ Y = 18 
            // ขัดมุมเฉียงอิงตามแกนหมุน ปิดผิว Closed Mesh เรียบร้อย
            //translate([-4, -30, -25]) cube([8, 60, 72]);
        }

        // --- 2. รูเจาะเรียบตรง ø3.2mm สำหรับรับเกลียวลูกยาง Damper (4 จุด พิกัดร่วม X = ±33, Y = ±11) ---
        translate([-33, -11, 45]) cylinder(d=3.2, h=8);
        translate([33, -11, 45]) cylinder(d=3.2, h=8);
        translate([-33, 11, 45]) cylinder(d=3.2, h=8);
        translate([33, 11, 45]) cylinder(d=3.2, h=8);

        // ====================================================
        // รูเจาะทะลุเรียบตรง ø2.2mm ยึด TFmini Plus (Y = ±14) เจาะทะลุตามแกน X
        // ====================================================
        translate([-10, -14, 6]) rotate([0, 90, 0]) cylinder(d=2.2, h=20);
        translate([-10, 14, -5.5]) rotate([0, 90, 0]) cylinder(d=2.2, h=20);

        // ====================================================
        // รูเจาะทะลุเรียบตรง ø3.2mm สำหรับยึด Intel RealSense D435i (M3 ห่างกัน 45mm หรือ Y = ±22.5)
        // ยกตำแหน่งขึ้นไปที่ระนาบความสูง Z = 30 (ขันน็อตยาว M3x8mm ทะลุแผ่น 8mm สบายๆ)
        // ====================================================
        translate([-10, -22.5, 30]) rotate([0, 90, 0]) cylinder(d=3.2, h=20);
        translate([-10, 22.5, 30]) rotate([0, 90, 0]) cylinder(d=3.2, h=20);

        // ====================================================
        // รูเจาะทะลุเรียบตรง ø2.7mm ยึดบอร์ดส่องพื้น MTF-01P 4 จุด (พิกัดกว้าง 24.3mm / ลึก 12mm)
        // ====================================================
        //translate([-10, -12.15, -26]) cylinder(d=2.7, h=6);
        //translate([-10, 12.15, -26]) cylinder(d=2.7, h=6);
        //translate([-22, -12.15, -26]) cylinder(d=2.7, h=6);
        //translate([-22, 12.15, -26]) cylinder(d=2.7, h=6);

        // ช่องหน้าต่างสี่เหลี่ยม เปิดโล่งเคลียร์เลนส์คู่และเลเซอร์ส่องพื้น (Size 10x18mm)
        //translate([-21, -9, -26]) cube([10, 18, 6]);
    }
}

// Sub-module: โครงสร้างครีบค้ำแนวหลัง (เรียงลำดับดรรชนีผิวถูกต้อง ไม่เกิด Error ตอนกด F6)
module r_smooth_rib_heavy_fixed() {
    polyhedron(
        points = [
            [0,  0,  0], [4,  0,  0], [4,  0, 22],
            [0,  0, 22], 
            [0,  5, 22], // <-- บรรทัดที่ 57: แก้เลข 8 เป็น 5 (หรือ 4)
            [4,  5, 22]  // <-- บรรทัดที่ 58: แก้เลข 8 เป็น 5 (หรือ 4)
        ],
        faces = [
            [3, 2, 1, 0], 
            [0, 1, 5, 4], 
            [2, 3, 4, 5], 
            [0, 4, 3],    
            [1, 2, 5]     
        ]
    );
}

// สั่งทำงานฟังก์ชันโครงสร้าง Front-Facing เสริมบ่ารับแรงหักหักถาวร
sensor_housing_front_facing_reinforced();