$fn = 60; // ความละเอียดรูกลมมาตรฐาน

module pi_cam3_and_tfmini_top_upward() {
    difference() {
        // --- 1. ชิ้นงานตันหลัก (Solid Body - แผ่นฐาน + ผนังตั้ง + แผ่นรับส่องฟ้าด้านบน + Rib ค้ำ) ---
        union() {
            // [ฐานแบนราบรับลูกยาง Damper] หนา 4mm ขนาดกว้าง 50x24mm (หน้าผิวราบรับลูกยางเกลียว M3)
            translate([-25, -12, 0]) cube([50, 24, 4]);
            
            // [ผนังตั้งหิ้วบอร์ดกล้อง Pi Cam 3] หนา 4mm แผ่นตันเต็มความแข็งแรงสูง (กว้าง 50mm / สูง 30mm)
            translate([-25, 8, 0]) cube([50, 4, 35]);
            
            // ====================================================
            // [แก้ไขแล้ว] ย้ายแผ่นนอนยึด TFmini Plus ส่องฟ้า ขึ้นมาอยู่ด้านบนสุด (Z = 26)
            // วางเชื่อมจากหลังผนังตั้ง (Y = 12 ถึง 36) หน้ากว้าง 36mm หนา 4mm 
            // ====================================================
            translate([-18, 0, 35]) cube([36, 24, 4]);
            
            // [ครีบ Rib ค้ำแรงแนวหน้า-หลัง] หนา 4mm วางกึ่งกลางเป๊ะ (X = -2 ถึง 2)
            // ผิวเนื้อเต็มสโลปลาดเอียงต่อเนื่องจากแผ่นตั้งลงมาหาแผ่นฐานด้านหน้าอย่างมั่นคง
            translate([-2, -12, 4])
            polyhedron(
                points = [
                    [0,  0,  0],  // 0: หน้าล่างซ้าย
                    [4,  0,  0],  // 1: หน้าล่างขวา
                    [4, 20,  0],  // 2: หลังล่างขวา (ชนผนังตั้ง)
                    [0, 20,  0],  // 3: หลังล่างซ้าย (ชนผนังตั้ง)
                    [0, 20, 15],  // 4: หลังบนซ้าย (ชนผนังตั้ง)
                    [4, 20, 15]   // 5: หลังบนขวา (ชนผนังตั้ง)
                ],
                faces = [
                    [3, 2, 1, 0], // ฐานล่าง
                    [0, 1, 5, 4], // แนวสโลปเอียงลาดลงหน้า
                    [2, 3, 4, 5], // ผนังหลังที่แนบติดแผ่นตั้ง
                    [0, 4, 3],    // ผนังข้างฝั่งซ้าย
                    [1, 2, 5]     // ผนังข้างฝั่งขวา
                ]
            );
        }
        
        // --- 2. รูเจาะเรียบตรง ø3.2mm สำหรับรับเกลียวสกรู M3 ของลูกยาง Damper (2 จุด ระยะห่าง 32mm) ---
        translate([-16, 0, -1]) cylinder(d=3.2, h=10);
        translate([16, 0, -1]) cylinder(d=3.2, h=10);
        
        // --- 3. รูเจาะทะลุเรียบตรง ø2.2mm สำหรับน็อต M2 ยึดบอร์ดกล้อง Pi Cam 3 (4 จุด มองไปข้างหน้า) ---
        // [รูคู่ล่าง] ระดับความสูง Z = 10.25mm
        translate([-10.5, 15, 10.25]) rotate([90,0,0]) cylinder(d=2.2, h=10);
        translate([10.5, 15, 10.25]) rotate([90,0,0]) cylinder(d=2.2, h=10);
        
        // [รูคู่บน] ระดับความสูง Z = 22.75mm
        translate([-10.5, 15, 22.75]) rotate([90,0,0]) cylinder(d=2.2, h=10);
        translate([10.5, 15, 22.75]) rotate([90,0,0]) cylinder(d=2.2, h=10);
        
        // ====================================================
        // [แก้ไขพิกัดดิ่ง] รูยึดและช่องแสงสำหรับ TFmini Plus ขยับขึ้นมาตัดทะลุแผ่นบนสุด (Z = 25)
        // จัดศูนย์กลางชุดเจาะไว้ที่ระนาบปีกบน (X = 0, Y = 24)
        // ====================================================
        // 4.1 รูยึดสกรู M2 รอบบอดี้ TFmini Plus 4 จุด (ระยะมาตรฐาน: กว้าง 28mm / ลึก 11.5mm) เจาะลึกทะลุเพลทบน
        translate([-14, 24 - 5.75, 25]) cylinder(d=2.2, h=10);
        translate([ 14, 24 - 5.75, 25]) cylinder(d=2.2, h=10);
        translate([-14, 24 + 5.75, 25]) cylinder(d=2.2, h=10);
        translate([ 14, 24 + 5.75, 25]) cylinder(d=2.2, h=10);
        
        // 4.2 ช่องหน้าต่างเปิดโล่งให้หน้าเลนส์ TFmini Plus ยิงแสงขึ้นฟ้าได้เต็ม 100% (Size 26x10mm)
        translate([-13, 19, 25]) cube([26, 10, 10]);
    }
}

// รันโมเดลรวมร่างเวอร์ชันแก้ไขแผ่นวาง TFmini ไว้บนสุดตามสั่ง
pi_cam3_and_tfmini_top_upward();