$fn = 60; // ความละเอียดรูกลมมาตรฐาน

module pi_cam3_damper_mount_fixed() {
    difference() {
        // --- 1. ชิ้นงานตันหลัก (Solid Body - แผ่นฐาน + ผนังตั้งทึบ + Rib ค้ำเนียน) ---
        union() {
            // [ฐานแบนราบรับลูกยาง] หนา 4mm ขนาดกว้าง 50x24mm หน้าสัมผัสเนียนราบเพื่อแนบกับฐานลูกยาง
            translate([-25, -12, 0]) cube([50, 24, 4]);
            
            // [ผนังตั้งหิ้วบอร์ดกล้อง] หนา 4mm แผ่นตันเต็มความแข็งแรงสูง (กว้าง 50mm / สูง 30mm)
            translate([-25, 8, 0]) cube([50, 4, 30]);
            
            // ====================================================
            // [แก้ไขแล้ว!] จัดระเบียบ Faces ใหม่ให้ Mesh ปิดสนิท ไม่เกิด Error ตอนกด F6
            // ====================================================
            translate([-2, -12, 4])
            polyhedron(
                points = [
                    [0,  0,  0],  // 0: หน้าล่างซ้าย
                    [4,  0,  0],  // 1: หน้าล่างขวา
                    [4, 20,  0],  // 2: หลังล่างขวา (ชนผนังตั้ง)
                    [0, 20,  0],  // 3: หลังล่างซ้าย (ชนผนังตั้ง)
                    [0, 20, 15],  // 4: หลังบนซ้าย (ชนผนังตั้ง)
                    [4, 20, 15]   // 5: หลังบนขวา (ชนผนังตั้ง)
                ],
                // เรียงลำดับทิศทางผิวหน้าใหม่ให้หันออกด้านนอกทุกด้าน (ทวนเข็ม/ตามเข็ม ตามกฎขวามือ)
                faces = [
                    [3, 2, 1, 0], // ฐานล่าง (มองจากใต้ท้อง)
                    [0, 1, 5, 4], // แนวสโลปเอียงลาดลงหน้า
                    [2, 3, 4, 5], // ผนังหลังที่แนบติดแผ่นตั้ง
                    [0, 4, 3],    // ผนังข้างฝั่งซ้าย
                    [1, 2, 5]     // ผนังข้างฝั่งขวา
                ]
            );
        }
        
        // --- 2. รูเจาะเรียบตรง ø3.2mm สำหรับรับเกลียวสกรู M3 ของลูกยาง Damper (2 จุด ระยะห่าง 32mm) ---
        translate([-16, 0, -1]) cylinder(d=3.2, h=10);
        translate([16, 0, -1]) cylinder(d=3.2, h=10);
        
        // --- 3. รูเจาะทะลุเรียบตรง ø2.2mm สำหรับน็อต M2 ยึดบอร์ดกล้อง Pi Cam 3 (4 จุดพิกัดเป๊ะ) ---
        // [รูคู่ล่าง] ระดับความสูง Z = 10.25mm
        translate([-10.5, 15, 10.25]) rotate([90,0,0]) cylinder(d=2.2, h=10);
        translate([10.5, 15, 10.25]) rotate([90,0,0]) cylinder(d=2.2, h=10);
        
        // [รูคู่บน] ระดับความสูง Z = 22.75mm
        translate([-10.5, 15, 22.75]) rotate([90,0,0]) cylinder(d=2.2, h=10);
        translate([10.5, 15, 22.75]) rotate([90,0,0]) cylinder(d=2.2, h=10);
    }
}

// เรียกใช้งานฟังก์ชันยึดกล้องเดี่ยวเวอร์ชันซ่อมแซมผิว Mesh เรียบร้อยแล้ว
pi_cam3_damper_mount_fixed();