# /etc/systemd/system/detect-sprinkler-zone1.service
[Unit]
Description=Sprinkler Detection Zone 1
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smartfarm
ExecStart=/usr/bin/python3 /home/pi/smartfarm/detect_sprinkler_zone1.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target